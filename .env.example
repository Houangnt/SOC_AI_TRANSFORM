# Copy to .env and fill in your Gemini API key.
SOC_AI_TRANSFORM_PROVIDER=gemini
GEMINI_API_KEY=
SOC_AI_TRANSFORM_MODEL=gemini-2.5-flash
SOC_AI_TRANSFORM_SMALL_MODEL=gemini-2.5-flash
SOC_AI_TRANSFORM_LLM_TIMEOUT=45

# Optional local paths / port. App defaults work without these.
# SOC_AI_TRANSFORM_HOME=.SOC_AI_TRANSFORM
# SOC_AI_TRANSFORM_DASHBOARD_PORT=9000

# Optional web search. Other integrations can be set up in Dashboard > Connections.
# TAVILY_API_KEY=

# Provided separately by the organisers; keep these assets outside public Git.
# SOC_AI_TRANSFORM_BUSINESS_SKILLS_ROOT=../business_skills
# SOC_AI_TRANSFORM_LIFEMATE_DATA_ROOT=../train+public_test
# SOC_AI_TRANSFORM_LIFEMATE_TRANSCRIPTS=../transcripts.json
